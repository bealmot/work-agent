# Per-site actuation config — TEMPLATE.
# Copy to local/sites.yaml on the work machine and fill in real hosts.
# local/ is git-ignored; never commit real internal hostnames.
#
# Every tool here is driven through the real managed Chrome via computer_use
# (see skills/browser-ops/SKILL.md). Layers describe PERCEPTION, since
# actuation is always element-indexed:
#
#   layer: 0 = the site's own API, read same-origin from page JS in the
#              authenticated tab. Cheapest by far where it works, and needs no
#              token: the session cookie already in the browser authenticates
#              it. Requires a recorded probe — never assume it.
#          1 = accessibility tree is sufficient. NOT automatically preferred:
#              on large-tree apps the tree truncates before it can be parsed.
#          2 = DOM via the legacy `page` tool
#          3 = needs pixels — currently UNAVAILABLE, the shim forces
#              include_screenshot=false. Flagging layer 3 is a request for an
#              operator decision, not a working config.
#
# probe notes: record what failed at the lower layer, and the date — sites
# change; re-probe when a layer-2/3 site gets a big UI update.

sites:
  - name: zendesk
    host: example.zendesk.com
    layer: 0
    notes: "same-origin API verified 10/10 on 2026-08-06 — see skills/zendesk-api"

  - name: outlook-web
    host: outlook.office.com
    layer: 1
    notes: ""

  - name: kibana
    host: kibana.internal.example.com
    layer: 1
    notes: ""

  - name: grafana
    host: grafana.internal.example.com
    layer: 1
    notes: "canvas panels unreadable via DOM — layer 3 candidate, read-only"

  - name: redash
    host: redash.internal.example.com
    layer: 1
    notes: ""

  - name: webapp-mgmt
    host: mgmt.internal.example.com
    layer: 2
    notes: "example: rejects synthetic events on action buttons (probed YYYY-MM-DD)"
